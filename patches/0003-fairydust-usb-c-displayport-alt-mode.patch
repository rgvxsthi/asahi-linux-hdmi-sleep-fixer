 cd321x_register_port(struct tps6598x *tps, struct fwnode_handle *fwnode)
 {
 	struct cd321x *cd321x = container_of(tps, struct cd321x, tps);
+	struct fwnode_handle *connector_fwnode = NULL;
 	int ret;
 
